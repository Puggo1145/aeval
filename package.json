{
  "name": "youeval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "Evaluation toolkit for YouMind services",
  "bin": {
    "youeval": "dist/interfaces/cli/entry.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.39",
    "@clack/prompts": "^1.1.0",
    "ai": "^6.0.111",
    "ajv": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "scripts": {
    "dev": "node --import tsx src/interfaces/cli/entry.ts",
    "start": "node dist/interfaces/cli/entry.js",
    "build": "tsc -p tsconfig.build.json",
    "example:basic-llm": "pnpm build && node --env-file=examples/basic-llm-test/.env --import tsx examples/basic-llm-test/main.ts",
    "example:file-edit-agent": "pnpm build && node --env-file=examples/file-edit-agent/.env --import tsx examples/file-edit-agent/main.ts",
    "lint": "biome check . --diagnostic-level=error",
    "lint:fix": "biome check . --write --diagnostic-level=error",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
