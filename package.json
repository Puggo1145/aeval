{
  "name": "@aeval/monorepo",
  "private": true,
  "type": "module",
  "description": "AEval monorepo",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "example:basics": "pnpm build && pnpm --filter @aeval/example-basics start",
    "lint": "biome check . --diagnostic-level=error",
    "lint:fix": "biome check . --write --diagnostic-level=error",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "publish:npm": "pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "publish:npm:core-graders": "pnpm -r --filter @aeval/core --filter @aeval/graders publish --access public --no-git-checks",
    "test": "pnpm build && node --import tsx --test",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck && pnpm -r --filter \"./examples/*\" run typecheck && pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "ai": "^6.0.111",
    "@clack/prompts": "^1.1.0"
  }
}
